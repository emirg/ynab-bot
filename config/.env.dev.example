# Default local development profile
APP_MODE=http-dev
EXTERNAL_MODE=stub
ENABLE_DEV_ROUTES=true
LOG_LEVEL=INFO

# Required base config
TOKEN_ENCRYPTION_KEY=replace_with_a_valid_fernet_key
HTTP_API_KEY=your-dev-http-key
DEV_API_KEY=your-dev-api-key
ADMIN_IDS=1
DATABASE_PATH=data/users-dev.db

# Optional for local live integrations profile
# TELEGRAM_BOT_TOKEN=
# OPENAI_API_KEY=
# YNAB_CLIENT_ID=
# YNAB_CLIENT_SECRET=
# YNAB_REDIRECT_URI=http://localhost:8080/oauth/callback
