# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# YNAB Personal Access Token
YNAB_ACCESS_TOKEN=your_ynab_access_token_here

# YNAB Budget ID (optional)
YNAB_BUDGET_ID=your_budget_id_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Admin User IDs (comma-separated list of Telegram user IDs)
# These users will have admin privileges to approve/block other users
# To get your Telegram user ID, message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321
