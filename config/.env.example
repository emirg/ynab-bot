# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Admin User IDs (comma-separated list of Telegram user IDs)
# These users will have admin privileges to approve/block other users
# To get your Telegram user ID, message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# YNAB OAuth Application (register at https://app.ynab.com/settings/developer)
YNAB_CLIENT_ID=your_ynab_client_id_here
YNAB_CLIENT_SECRET=your_ynab_client_secret_here
YNAB_REDIRECT_URI=https://your-domain.up.railway.app/oauth/callback

# Token Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# HTTP API Key for authenticated internal endpoints
HTTP_API_KEY=your_http_api_key_here

# YNAB Budget ID (optional, legacy)
# YNAB_BUDGET_ID=your_budget_id_here
